{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/work/:slug(quiver|solana-diary|uncx-menu|uncx-rebrand|badger-club|uncx-video-system|uncx-academy|noticia-lingo|uncx-app-concepts|ai-portfolio-system)",
      "destination": "/work/:slug/index.html"
    },
    {
      "source": "/cv",
      "destination": "/cv/index.html"
    },
    {
      "source": "/study",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|case-studies/|earlier-work/|portrait/|models/|cv/).*)",
      "destination": "/index.html"
    }
  ]
}
