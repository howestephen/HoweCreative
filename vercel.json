{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/work/:slug",
      "destination": "/?study=:slug",
      "permanent": false
    },
    {
      "source": "/work/:slug/",
      "destination": "/?study=:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/particle-redesign",
      "destination": "https://howecreative-particle-howestephen-projects.vercel.app/"
    },
    {
      "source": "/particle-redesign/:path*",
      "destination": "https://howecreative-particle-howestephen-projects.vercel.app/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://howecreative-particle-howestephen-projects.vercel.app/assets/:path*"
    },
    {
      "source": "/case-studies/:path*",
      "destination": "https://howecreative-particle-howestephen-projects.vercel.app/case-studies/:path*"
    },
    {
      "source": "/earlier-work/:path*",
      "destination": "https://howecreative-particle-howestephen-projects.vercel.app/earlier-work/:path*"
    },
    {
      "source": "/portrait/:path*",
      "destination": "https://howecreative-particle-howestephen-projects.vercel.app/portrait/:path*"
    },
    {
      "source": "/models/:path*",
      "destination": "https://howecreative-particle-howestephen-projects.vercel.app/models/:path*"
    },
    {
      "source": "/cv/:file.pdf",
      "destination": "https://howecreative-particle-howestephen-projects.vercel.app/cv/:file.pdf"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://hcaptcha.com https://*.hcaptcha.com; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' https://api.web3forms.com https://hcaptcha.com https://*.hcaptcha.com; frame-src https://hcaptcha.com https://*.hcaptcha.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/case-studies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/earlier-work/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/portrait/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
