{
  "warn_words": 2000,
  "fail_words": 3000,
  "archive_dir": "_archive/",
  "allowlist": [
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "ONBOARDING.md",
    "ROADMAP.md",
    "ARCHITECTURE.md",
    "CONVENTIONS.md",
    "handoffs/TEMPLATE.md"
  ],
  "growable": [
    {
      "dir": "handoffs/",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\.md$"
    },
    {
      "dir": "docs/plans/",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\.md$"
    },
    {
      "dir": "docs/reviews/",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\.md$"
    },
    {
      "dir": "docs/",
      "pattern": "^[a-z0-9-]+\\.md$"
    }
  ],
  "ignore": [
    "^_archive/",
    "^node_modules/",
    "^\\.claude/",
    "^dist/",
    "^assets-archive/",
    "^docs/private/",
    "^docs/reviews/2026-09-07-design-reset/"
  ],
  "top_dirs": [
    ".claude",
    ".github",
    "_archive",
    "api",
    "docs",
    "handoffs",
    "public",
    "scripts",
    "src"
  ]
}
