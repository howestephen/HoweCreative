{
  "name": "howe-creative-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint src api",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "ci:select": "node scripts/ci-select.mjs gate",
    "ci:pr": "node scripts/ci-select.mjs pr",
    "ci:pr:full": "npm run typecheck && npm run lint && npm test && npm run build",
    "ci:changed": "vitest related --run --passWithNoTests",
    "ci:main": "node scripts/ci-select.mjs main",
    "ci:main:full": "npm run ci:pr:full"
  },
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.13.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.11.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "^6.4.1",
    "vitest": "^4.1.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.1"
    }
  }
}
